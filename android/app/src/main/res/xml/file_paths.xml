<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes the app's external-files tree (which is where the shared/
     download folder lives, see defaultDownloadDir()) to other apps via
     FileProvider, so a received file can be handed to a viewer app
     without violating scoped storage. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="shared_files" path="." />
</paths>
